{
  "name": "rulebase",
  "version": "0.2.0",
  "description": "Local, read-only knowledge base over an IBM ODM Rule Designer workspace, served to AI assistants over MCP.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "rulebase": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "bench": "node --expose-gc --experimental-strip-types --no-warnings=ExperimentalWarning bench/bench.ts",
    "rulebase": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/cli.ts",
    "format": "prettier --write .",
    "check:dist": "npm run build && git diff --exit-code -- dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-xml-parser": "^5.12.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.4.0",
    "typescript": "^5.9.3"
  }
}
