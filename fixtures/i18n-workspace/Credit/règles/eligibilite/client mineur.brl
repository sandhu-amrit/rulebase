<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>client mineur</name>
  <uuid>r-2</uuid>
  <locale>fr_FR</locale>
  <definition><![CDATA[définitions
    set 'le client' to le client de 'la demande' ;
si
    l'âge du 'le client' est inférieur à 18
alors
    dans 'le rapport', rejeter la demande avec le message "mineur" ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
