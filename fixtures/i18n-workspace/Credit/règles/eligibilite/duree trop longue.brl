<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>duree trop longue</name>
  <uuid>r-1</uuid>
  <locale>fr_FR</locale>
  <definition><![CDATA[si
    la duree mois de 'la demande' est plus grand que 300
alors
    ajouter "DUREE_TROP_LONGUE" aux motifs du 'rapport' ;
sinon
    assigner l'âge du client de 'la demande' à 30 ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
