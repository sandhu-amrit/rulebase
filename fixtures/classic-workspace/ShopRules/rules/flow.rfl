<ilog.rules.studio.model.ruleflow:RuleFlow xmlns:ilog.rules.studio.model.ruleflow="http://ilog.rules.studio/model/ruleflow.ecore">
  <name>flow</name><uuid>rfl-1</uuid><locale>en_US</locale>
  <rfModel>
<Ruleflow xmlns="http://schemas.ilog.com/Rules/7.0/Ruleflow">
  <Body>
    <TaskList>
      <StartTask Identifier="begin"/>
      <RuleTask ExecutionMode="RetePlus" Identifier="Tiers"><RuleList><Package Name="tiers"/></RuleList></RuleTask>
      <RuleTask ExecutionMode="Fastpath" Identifier="Offers"><RuleList><Package Name="offers"/></RuleList></RuleTask>
      <StopTask Identifier="finish"/>
    </TaskList>
    <NodeList>
      <TaskNode Identifier="n0" Task="begin"/>
      <ForkNode Identifier="n1"/>
      <TaskNode Identifier="n2" Task="Tiers"/>
      <TaskNode Identifier="n3" Task="Offers"/>
      <JoinNode Identifier="n4"/>
      <TaskNode Identifier="n5" Task="finish"/>
    </NodeList>
    <TransitionList>
      <Transition Identifier="t0" Source="n0" Target="n1"/>
      <Transition Identifier="t1" Source="n1" Target="n2"/>
      <Transition Identifier="t2" Source="n1" Target="n3"/>
      <Transition Identifier="t3" Source="n2" Target="n4"/>
      <Transition Identifier="t4" Source="n3" Target="n4"/>
      <Transition Identifier="t5" Source="n4" Target="n5"/>
    </TransitionList>
  </Body>
</Ruleflow>
  </rfModel>
</ilog.rules.studio.model.ruleflow:RuleFlow>
