<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>nearby friend</name>
  <uuid>r-4</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    distance in km from ('the customer') to ('the friend') is less than 10
then
    set the tier of 'the friend' to Silver ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
