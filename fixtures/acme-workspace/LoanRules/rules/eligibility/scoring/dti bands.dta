<?xml version="1.0" encoding="UTF-8"?>
<model.dt:DecisionTable xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:model.dt="http://ilog.rules.studio/model/dt.ecore">
  <name>dti bands</name>
  <uuid>dta-0001</uuid>
  <locale>en_US</locale>
  <definition>
<DT xmlns="http://schemas.ilog.com/Rules/7.0/DecisionTable" Version="7.0">
  <Body>
    <Structure>
      <ConditionDefinitions>
        <ConditionDefinition Id="C0">
          <ExpressionDefinition><Text><![CDATA[the debt ratio of 'the borrower' is at least <min> and less than <max>]]></Text></ExpressionDefinition>
        </ConditionDefinition>
      </ConditionDefinitions>
      <ActionDefinitions>
        <ActionDefinition Id="A0">
          <ExpressionDefinition><Text><![CDATA[set the score band of 'the loan' to <a string>]]></Text></ExpressionDefinition>
        </ActionDefinition>
      </ActionDefinitions>
    </Structure>
    <Contents>
      <Partition DefId="C0">
        <Condition><Expression><Param><![CDATA[0]]></Param><Param><![CDATA[0.3]]></Param></Expression>
          <ActionSet><Action DefId="A0"><Expression><Param><![CDATA["low"]]></Param></Expression></Action></ActionSet>
        </Condition>
        <Condition><Expression><Param><![CDATA[0.3]]></Param><Param><![CDATA[0.4]]></Param></Expression>
          <ActionSet><Action DefId="A0"><Expression><Param><![CDATA["medium"]]></Param></Expression></Action></ActionSet>
        </Condition>
        <Condition><Expression><Param><![CDATA[0.4]]></Param><Param><![CDATA[10]]></Param></Expression>
          <ActionSet><Action DefId="A0"><Expression><Param><![CDATA["high"]]></Param></Expression></Action></ActionSet>
        </Condition>
      </Partition>
    </Contents>
  </Body>
</DT>
  </definition>
</model.dt:DecisionTable>
