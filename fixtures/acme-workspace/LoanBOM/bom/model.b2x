<b2x:javaXOMMapping xmlns:b2x="http://schemas.ilog.com/JRules/1.1/B2X">
  <class>
    <businessName>com.acme.loan.Borrower</businessName>
    <executionName>com.acme.loan.Borrower</executionName>
    <attribute>
      <name>debtRatio</name>
      <getter language="irl"><![CDATA[return (this.monthlyDebt * 12) / this.getYearlyIncome();]]></getter>
